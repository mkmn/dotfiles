{
  "solargraph.diagnostics": true,

  // ---- ESLint ----
  // 既存のESLintルールはそのまま活かす（フォーマットはprettierに任せるためautoFixOnSaveはfalse）
  "eslint.enable": true,
  "eslint.autoFixOnSave": false,
  "eslint.run": "onType",

  // ---- oxlint (coc-oxc) ----
  // ESLintと併用。プロジェクト側でeslint-plugin-oxlintを使い、
  // oxlintがカバーするルールをESLint側で無効化すると二重警告を防げます
  "oxc.oxlint.enable": true,
  "oxc.oxlint.run": "onType",
  "oxc.oxlint.codeActionsOnSave": ["source.fixAll.oxc"],

  // ---- binPath (保険) ----
  // 通常はworkspace.root配下のnode_modules/.bin/{oxlint,oxfmt}を自動探索するため不要。
  // モノレポで「サブディレクトリではなくリポジトリルートでnvimを開いてしまった」場合、
  // 自動探索が失敗して:CocList servicesにoxlint/oxfmtが出てこない現象が起きる。
  // その時はコメントを外し、実際のプロジェクトの絶対パスに書き換えて使う。
  // "oxc.oxlint.binPath": "/absolute/path/to/project/node_modules/.bin/oxlint",
  // "oxc.oxfmt.binPath": "/absolute/path/to/project/node_modules/.bin/oxfmt",

  // ---- フォーマッター ----
  // oxfmtが有効な場合はそちらを優先し、無い場合はprettierにフォールバックさせたいので、
  // coc.preferences.formatterExtension で特定の拡張に固定しない。
  // coc-oxcはデフォルトで oxc.oxfmt.formatterPriority=1 を持ち、
  // 優先度未設定の他フォーマッタ(coc-prettier)より優先されるため、
  // プロジェクトにoxfmtがあれば自動的にそちらが使われ、無ければprettierが使われる。
  "oxc.oxfmt.enable": true,
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "css",
    "markdown"
  ],

  // ---- Terraform (terraform-ls) ----
  // coc.nvim専用の拡張機能は無いため、汎用languageserver設定で直接繋ぐ。
  // 事前に `brew install hashicorp/tap/terraform-ls` 等でバイナリのインストールが必要
  "languageserver": {
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "filetypes": ["terraform", "tf"]
    }
  }
}
